{
  "name": "gesture-space-explorer",
  "version": "2.4.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe-assets.mjs",
    "prebuild": "node scripts/copy-mediapipe-assets.mjs && node scripts/validate-spaceport.mjs",
    "assets:validate": "node scripts/validate-spaceport.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --test --test-concurrency=1 tests/browser/smoke.test.mjs",
    "textures:build": "node scripts/build-textures.mjs .texture-sources --download"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "1.64.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
